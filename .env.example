# ── LLM provider (Phase 1 text chat) ──────────────────────────────────────────
# Pick one: anthropic | openai | gemini
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Google integrations (always required) ──────────────────────────────────────
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ── App ────────────────────────────────────────────────────────────────────────
TIMEZONE=America/Los_Angeles
MAX_TOKENS=1024

# ── Vapi voice integration (Phase 2) ───────────────────────────────────────────
# 1. Get VAPI_API_KEY from app.vapi.ai → Account → API Keys
# 2. Expose this server publicly (ngrok in dev): ngrok http 8000
#    Set SERVER_BASE_URL to the ngrok https URL (no trailing slash)
# 3. Run: python -m scripts.create_vapi_assistant
# 4. Copy the printed assistant ID into VAPI_ASSISTANT_ID
# 5. Assign a phone number to the assistant in the Vapi dashboard
VAPI_API_KEY=your_vapi_api_key_here
SERVER_BASE_URL=https://your-ngrok-url.ngrok.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VAPI_ASSISTANT_ID=
